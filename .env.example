# ---------------------------------------------------------------------------
# Agentic Legal Intelligence Platform — environment configuration.
# Copy to `.env` and adjust. NEVER commit a real .env. No secrets belong in code.
# All settings are prefixed LEGALINTEL_ and loaded via pydantic-settings.
# ---------------------------------------------------------------------------

# --- LLM provider selection --------------------------------------------------
# "mock"    -> deterministic, offline, no AWS calls (default; used by tests/CI)
# "bedrock" -> Amazon Bedrock (pay-per-call; requires AWS credentials in env)
LEGALINTEL_LLM_PROVIDER=mock

# --- Amazon Bedrock ----------------------------------------------------------
# us-east-1 has the broadest Claude availability. Enable model access first:
# AWS console -> Bedrock -> Model access -> request the Claude model(s).
LEGALINTEL_AWS_REGION=us-east-1
# Cheapest current Claude ($1/$5 per M tokens); great for this task.
# Current Claude models are NOT on-demand invokable by bare id — use a
# cross-region inference profile id (us./global. prefix). Discover the ids your
# account exposes with `python scripts/check_bedrock.py`.
LEGALINTEL_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Titan embeddings for the dense retrieval leg (only used when EMBEDDER=bedrock).
LEGALINTEL_BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Embedder selection ------------------------------------------------------
# "hashing" -> deterministic local vectorizer, no cost/network (default)
# "bedrock" -> Titan embeddings via Bedrock
LEGALINTEL_EMBEDDER=hashing

# --- Corpus ------------------------------------------------------------------
# Local directory of authority documents (JSON). Overridden by S3 in deployed envs.
LEGALINTEL_CORPUS_DIR=data/corpus
# Optional: pull corpus from S3 (set by CDK output). Leave blank for local.
LEGALINTEL_CORPUS_S3_BUCKET=

# --- Retrieval / grounding tuning -------------------------------------------
LEGALINTEL_RETRIEVAL_TOP_K=5
# Weight of the dense leg in hybrid fusion (0..1); BM25 gets the remainder.
LEGALINTEL_HYBRID_DENSE_WEIGHT=0.5
# A claim must be supported above this cosine/overlap score or the system abstains.
LEGALINTEL_GROUNDING_THRESHOLD=0.18

# --- Reliability guardrails --------------------------------------------------
LEGALINTEL_LLM_TIMEOUT_SECONDS=30
LEGALINTEL_LLM_MAX_RETRIES=3

# --- Observability -----------------------------------------------------------
# "json" for structured production logs, "console" for human-readable dev logs.
LEGALINTEL_LOG_FORMAT=console
LEGALINTEL_LOG_LEVEL=INFO
